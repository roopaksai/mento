# Deployment scripts for different platforms

# Install dependencies
install:
	npm install

# Development
dev:
	npm run dev

# Build for production
build:
	npm run build

# Preview production build
preview:
	npm run preview

# Lint code
lint:
	npm run lint

# Clean install (removes node_modules)
clean-install:
	rm -rf node_modules package-lock.json
	npm install

# Update dependencies
update:
	npm update

# Security audit
audit:
	npm audit

.PHONY: install dev build preview lint clean-install update audit
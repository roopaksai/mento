# Mental Wellness API Environment Variables

# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=development
DATABASE_PATH=database.db

# CORS Settings
CORS_ORIGINS=http://localhost:3000

# Institution Settings (for future expansion)
ENABLE_EMAIL_NOTIFICATIONS=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Crisis Support Settings
CRISIS_KEYWORDS_ENABLED=true
AUTO_ESCALATION_ENABLED=false

# Analytics (for future expansion)
ENABLE_ANALYTICS=false
ANALYTICS_ENDPOINT=https://your-analytics-service.com

# Note: In production, never commit .env files to version control
# Copy this to .env and fill in real values